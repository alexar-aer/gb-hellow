///<summary>
///
///</summary>
unit uMainForm;

interface

uses
    Windows,
    Messages,
    SysUtils,
    Variants,
    Classes,
    Graphics,
    Controls,
    Forms,
    Dialogs,
    StdCtrls,
    ComCtrls,
    ExtCtrls,
    Menus,
    dglOpenGL,
    uLocalization,
    uLangEnglish,
    uLangRussian,
    uTypes,
    uMeasure;

type
    TMainForm = class(TForm)
        MainMenu1: TMainMenu;
        FileMenu: TMenuItem;
        LoadMenuItem: TMenuItem;
        ExitMenuItem: TMenuItem;
        ToolsMenu: TMenuItem;
        AddPointMenuItem: TMenuItem;
        ClearMenuItem: TMenuItem;
        ExportMenuItem: TMenuItem;
        Panel1: TPanel;
        ListView1: TListView;
        OpenDialog1: TOpenDialog;
        SaveDialog1: TSaveDialog;
        Language1: TMenuItem;
        English1: TMenuItem;
        Russian1: TMenuItem;
        procedure FormCreate(Sender: TObject);
        procedure FormDestroy(Sender: TObject);
        procedure LoadMenuItemClick(Sender: TObject);
        procedure ClearMenuItemClick(Sender: TObject);
        procedure ExportMenuItemClick(Sender: TObject);
        procedure ExitMenuItemClick(Sender: TObject);
        procedure UpdateInterfaceStrings;
    private
        FMeasurementMgr: TMeasurementManager;
        FVertices: array of TVertex;
        FFaces: array of TFace;
        FGLInitialized: Boolean;
        procedure InitOpenGL;
        procedure UpdateView;
        procedure ApplyLanguage(ALang: TAppLanguage);
    public
        property MeasurementManager: TMeasurementManager read
            FMeasurementMgr;
    end;

var
    MainForm             : TMainForm;

implementation

{$R *.dfm}

uses
    uRenderer,
    uUtils;

procedure TMainForm.FormCreate(Sender: TObject);
begin
    // Подписка на событие смены языка
    LocMgr.OnChange := nil; // Чтобы не сработало лишний раз при старте
    LocMgr.OnChange := UpdateInterfaceStrings;
    // Установка начального языка (English)
    ApplyLanguage(alEnglish);

    FMeasurementMgr := TMeasurementManager.Create;
    SetLength(FVertices, 10000);
    SetLength(FFaces, 10000);
    FGLInitialized := False;
    // Инициализация OpenGL и т.д.
    InitOpenGL;
end;

procedure TMainForm.FormDestroy(Sender: TObject);
begin
    FMeasurementMgr.Free;
    dglDeleteContext;
end;

procedure TMainForm.InitOpenGL;
begin
    FGLInitialized := True;
end;

procedure TMainForm.UpdateView;
begin
    if FGLInitialized then
        PaintGL(FVertices, FFaces,
            TPoint3D(Pointer(@FMeasurementMgr.Points[0])^));  // РЈРїСЂРѕС‰РµРЅРЅРѕ
end;

procedure TMainForm.LoadMenuItemClick(Sender: TObject);
begin
    if OpenDialog1.Execute then begin
        if LoadOBJ(OpenDialog1.FileName, FVertices, FFaces) then begin
            Caption := '3D Measure: ' +
                ExtractFileName(OpenDialog1.FileName);
            UpdateView;
        end else
            ShowMessage('XXX!');
    end;
end;

procedure TMainForm.ClearMenuItemClick(Sender: TObject);
begin
    FMeasurementMgr.ClearPoints;
    ListView1.Items.Clear;
    UpdateView;
end;

procedure TMainForm.ExportMenuItemClick(Sender: TObject);
begin
    if SaveDialog1.Execute then begin
        FMeasurementMgr.ExportToTable(ListView1);
        ShowMessage('ЧЧЧ');
    end;
end;

procedure TMainForm.ExitMenuItemClick(Sender: TObject);
begin
    Close;
end;

procedure TMainForm.UpdateInterfaceStrings;
var
    IsEng                : Boolean;
begin
    IsEng := (LocMgr.CurrentLanguage = alEnglish);

    // --- Меню ---
    if IsEng then begin
        miFile.Caption := SMenuFile;    // '&File'
        miView.Caption := SMenuView;
        miTools.Caption := SMenuTools;
        miLanguage.Caption := SMenuLanguage;
        miLangEn.Caption := SMenuLangEn;
        miLangRu.Caption := SMenuLangRu;
        // miLoad.Caption := SMenuLoadModel;

        Caption := SCaptionMain;
    end else begin
        miFile.Caption := SMenuFile;    // '&Файл' (из русского модуля)
        miView.Caption := SMenuView;
        miTools.Caption := SMenuTools;
        miLanguage.Caption := SMenuLanguage;
        miLangEn.Caption := SMenuLangEn;
        miLangRu.Caption := SMenuLangRu;

        Caption := SCaptionMain;
    end;

    // --- Элементы управления (пример) ---
    // lblStatus.Caption := IfThen(IsEng, 'Ready', 'Готово');
    // btnExport.Caption := IfThen(IsEng, SBtnExport, SBtnExport); // Опять же, берем из нужного контекста

    // Обновление грида (заголовки колонок)
    // StringGrid1.Cells[0,0] := IfThen(IsEng, uLangEnglish.cColIndex, uLangRussian.cColIndex);
end;

procedure TMainForm.ApplyLanguage(ALang: TAppLanguage);
begin
    LocMgr.CurrentLanguage := ALang;
    // Обновляем состояние чекбоксов в меню
    miLangEn.Checked := (ALang = alEnglish);
    miLangRu.Checked := (ALang = alRussian);

    UpdateInterfaceStrings;
end;

end.

