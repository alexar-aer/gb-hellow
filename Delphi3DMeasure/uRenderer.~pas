unit uRenderer;

interface

///<summary>
/// Модуль отвечает за рендеринг 3D-сцены с использованием OpenGL.
/// Содержит класс TSceneManager для управления камерой, освещением и отрисовкой объектов.
/// Статистика:
/// - Типы: 1 (TSceneManager)
/// - Классы: 1 (TSceneManager, 6 методов)
/// - Функции/Процедуры: 2 (вспомогательные)
/// - Константы: 0
/// - Глобальные переменные: 0
///</summary>

uses
    Windows,
    SysUtils,
    Classes,
    Controls,
    Forms,
    dglOpenGL,
    uMath,
    uTypes;

type
    ///<summary>
    /// Менеджер сцены. Управляет состоянием OpenGL, камерой и отрисовкой модели.
    ///</summary>
    TSceneManager = class
    private
        FDC: HDC;
        FRC: HGLRC;
        FHandle: HWND;
        FIsInitialized: Boolean;

        // Параметры камеры
        FCameraPos: TGLVector3f;
        FCameraTarget: TGLVector3f;
        FCameraUp: TGLVector3f;

        // Параметры вида
        FRotX, FRotY: Single;
        FZoom: Single;

        procedure SetupProjection(Width, Height: Integer);
        procedure SetupModelview;
    public
        constructor Create(AHandle: HWND);
        destructor Destroy; override;

        function Initialize: Boolean;
        procedure Resize(Width, Height: Integer);
        procedure Render(const Vertices: TVertexArray; const Normals:
            TVertexArray;
            Wireframe: Boolean; const Points: TVector3Array; PointCount:
                Integer);

        procedure RotateView(DeltaX, DeltaY: Single);
        procedure ZoomView(Delta: Single);
        procedure ResetView;

        property IsInitialized: Boolean read FIsInitialized;
    end;

    ///<summary>
    /// Вспомогательная функция для создания вектора TVector3f в Delphi 7.
    /// Возвращает заполненную структуру.
    ///</summary>
function FakeVector3f(const a0: Single; const a1: Single; const a2:
    Single): TGLVector3f;

implementation

function FakeVector3f(const a0: Single; const a1: Single; const a2:
    Single): TGLVector3f;
begin
    Result[0] := a0;
    Result[1] := a1;
    Result[2] := a2;
end;

{ TSceneManager }

constructor TSceneManager.Create(AHandle: HWND);
begin
    inherited Create;
    FHandle := AHandle;
    FIsInitialized := False;
    FRC := 0;
    FDC := 0;

    // Инициализация параметров камеры по умолчанию
    FCameraPos := FakeVector3f(0, 0, 5);
    FCameraTarget := FakeVector3f(0, 0, 0);
    FCameraUp := FakeVector3f(0, 1, 0);

    FRotX := 0;
    FRotY := 0;
    FZoom := 1.0;
end;

destructor TSceneManager.Destroy;
begin
    if FRC <> 0 then begin
        wglMakeCurrent(0, 0);
        wglDeleteContext(FRC);
    end;
    if FDC <> 0 then
        ReleaseDC(FHandle, FDC);
    inherited Destroy;
end;

function TSceneManager.Initialize: Boolean;
var
    pfd                  : TPixelFormatDescriptor;
    pf                   : Integer;
begin
    Result := False;

    FDC := GetDC(FHandle);
    if FDC = 0 then Exit;

    FillChar(pfd, SizeOf(pfd), 0);
    with pfd do begin
        nSize := SizeOf(TPixelFormatDescriptor);
        nVersion := 1;
        dwFlags := PFD_DRAW_TO_WINDOW or PFD_SUPPORT_OPENGL or
            PFD_DOUBLEBUFFER;
        iPixelType := PFD_TYPE_RGBA;
        cColorBits := 24;
        cDepthBits := 32;
        iLayerType := PFD_MAIN_PLANE;
    end;

    pf := ChoosePixelFormat(FDC, @pfd);
    if pf = 0 then Exit;

    if not SetPixelFormat(FDC, pf, @pfd) then Exit;

    // Исправление: использование wglCreateContext вместо dglCreateContext
    FRC := wglCreateContext(FDC);
    if FRC = 0 then Exit;

    // Исправление: использование wglMakeCurrent вместо dglMakeCurrent
    if not wglMakeCurrent(FDC, FRC) then begin
        wglDeleteContext(FRC);
        FRC := 0;
        Exit;
    end;

    FIsInitialized := True;

    // Базовая настройка OpenGL
    glClearColor(0.2, 0.2, 0.2, 1.0);
    glEnable(GL_DEPTH_TEST);
    glEnable(GL_LIGHTING);
    glEnable(GL_LIGHT0);
    glEnable(GL_NORMALIZE);

    Result := True;
end;

procedure TSceneManager.SetupProjection(Width, Height: Integer);
begin
    if Height = 0 then Height := 1;

    glViewport(0, 0, Width, Height);

    glMatrixMode(GL_PROJECTION);
    glLoadIdentity;

    gluPerspective(45.0, Width / Height, 0.1, 1000.0);
end;

procedure TSceneManager.SetupModelview;
begin
    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity;

    // Применение вращения и зума
    glTranslatef(0, 0, -FZoom * 5);     // Базовое отдаление

    // Вращение вокруг центра
    glRotatef(FRotX, 1, 0, 0);
    glRotatef(FRotY, 0, 1, 0);

    // Установка камеры (если нужно использовать gluLookAt)
    // gluLookAt(FCameraPos.X, FCameraPos.Y, FCameraPos.Z,
    //           FCameraTarget.X, FCameraTarget.Y, FCameraTarget.Z,
    //           FCameraUp.X, FCameraUp.Y, FCameraUp.Z);
end;

procedure TSceneManager.Resize(Width, Height: Integer);
begin
    if not FIsInitialized then Exit;
    wglMakeCurrent(FDC, FRC);
    SetupProjection(Width, Height);
end;

procedure TSceneManager.Render(const Vertices: TVertexArray; const
    Normals: TVertexArray;
    Wireframe: Boolean; const Points: TVector3Array; PointCount:
        Integer);
var
    I                    : Integer;
    LightPos             : array[0..3] of GLfloat;
    PLight: PGLfloat;
begin
    if not FIsInitialized then Exit;

    wglMakeCurrent(FDC, FRC);

    glClear(GL_COLOR_BUFFER_BIT or GL_DEPTH_BUFFER_BIT);

    SetupModelview;

    // Настройка света
    LightPos[0] := 5.0;
    LightPos[1] := 5.0;
    LightPos[2] := 10.0;
    LightPos[3] := 1.0;
    PLight := @LightPos;
    glLightfv(GL_LIGHT0, GL_POSITION, PLight);

    if Wireframe then
        glPolygonMode(GL_FRONT_AND_BACK, GL_LINE)
    else
        glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);

    // Отрисовка модели
    if Length(Vertices) > 0 then begin
        glBegin(GL_TRIANGLES);
        for I := 0 to High(Vertices) do begin
            if Length(Normals) > I then
                glNormal3f(Normals[I].X, Normals[I].Y, Normals[I].Z)
            else
                glNormal3f(0, 0, 1);

            glVertex3f(Vertices[I].X, Vertices[I].Y, Vertices[I].Z);
        end;
        glEnd;
    end;

    // Отрисовка точек измерений
    if PointCount > 0 then begin
        glPointSize(8.0);
        glBegin(GL_POINTS);
        glColor3f(1.0, 0.0, 0.0);       // Красный цвет для точек
        for I := 0 to PointCount - 1 do begin
            glVertex3f(Points[I].Pos.X, Points[I].Pos.Y,
                Points[I].Pos.Z);
        end;
        glEnd;

        // Отрисовка линий между точками
        if PointCount > 1 then begin
            glBegin(GL_LINES);
            glColor3f(0.0, 1.0, 0.0);   // Зеленый цвет для линий
            for I := 0 to PointCount - 2 do begin
                glVertex3f(Points[I].Pos.X, Points[I].Pos.Y,
                    Points[I].Pos.Z);
                glVertex3f(Points[I + 1].Pos.X, Points[I + 1].Pos.Y,
                    Points[I + 1].Pos.Z);
            end;
            glEnd;
        end;
    end;

    SwapBuffers(FDC);
end;

procedure TSceneManager.RotateView(DeltaX, DeltaY: Single);
begin
    FRotY := FRotY + DeltaX;
    FRotX := FRotX + DeltaY;

    // Ограничение вертикального угла
    if FRotX > 90 then FRotX := 90;
    if FRotX < -90 then FRotX := -90;
end;

procedure TSceneManager.ZoomView(Delta: Single);
begin
    FZoom := FZoom + Delta * 0.1;
    if FZoom < 0.1 then FZoom := 0.1;
    if FZoom > 10.0 then FZoom := 10.0;
end;

procedure TSceneManager.ResetView;
begin
    FRotX := 0;
    FRotY := 0;
    FZoom := 1.0;
    FCameraPos := FakeVector3f(0, 0, 5);
end;

end.

