unit uLocalization;

interface

uses
  Classes, SysUtils;

type
  TLanguage = (langEnglish, langRussian);

  TStringResource = function: string;

  TLocalizationManager = class
  private
    FCurrentLanguage: TLanguage;
    FOnLanguageChange: TNotifyEvent;
    procedure SetCurrentLanguage(const Value: TLanguage);
  public
    constructor Create;
    procedure RegisterString(const AKey: string; const AEngStr, ARusStr: string);
    function GetString(const AKey: string): string;
    property CurrentLanguage: TLanguage read FCurrentLanguage write SetCurrentLanguage;
    property OnLanguageChange: TNotifyEvent read FOnLanguageChange write FOnLanguageChange;
  end;

var
  LocManager: TLocalizationManager;

implementation

{ TLocalizationManager }

constructor TLocalizationManager.Create;
begin
  inherited Create;
  FCurrentLanguage := langEnglish; // Язык по умолчанию
end;

procedure TLocalizationManager.SetCurrentLanguage(const Value: TLanguage);
begin
  if FCurrentLanguage <> Value then
  begin
    FCurrentLanguage := Value;
    if Assigned(FOnLanguageChange) then
      FOnLanguageChange(Self);
  end;
end;

